{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repoimmune.dev/schema/behavior-card-1.0.0.json",
  "title": "RepoImmune Behavior Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "bug_trigger", "observed_failure", "affected_symbols", "buggy_pattern", "fixed_pattern", "invariant", "reproducer", "regression_tests", "applicability", "evidence", "confidence", "limitations", "source_commit", "fixed_commit", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 8},
    "bug_trigger": {"type": "string"},
    "observed_failure": {"type": "string"},
    "affected_symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
    "buggy_pattern": {"$ref": "#/$defs/pattern"},
    "fixed_pattern": {"$ref": "#/$defs/pattern"},
    "invariant": {"type": "string"},
    "reproducer": {"type": "object", "required": ["capsule_id", "status"], "properties": {"capsule_id": {"type": "string"}, "status": {"enum": ["verified", "externally_reported", "heuristic", "inconclusive"]}}, "additionalProperties": true},
    "regression_tests": {"type": "array", "items": {"type": "object", "required": ["path", "name"], "properties": {"path": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": true}},
    "applicability": {"type": "object", "additionalProperties": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"type": "object", "required": ["score", "classification"], "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}, "classification": {"enum": ["verified", "externally_reported", "heuristic", "inconclusive"]}}, "additionalProperties": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {"type": "string"},
    "license": {"type": "object", "additionalProperties": true},
    "timestamps": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "symbol": {"type": "object", "required": ["path", "symbol"], "properties": {"path": {"type": "string"}, "symbol": {"type": "string"}, "language": {"type": "string"}}, "additionalProperties": true},
    "pattern": {"type": "object", "required": ["code", "kind"], "properties": {"code": {"type": "string"}, "kind": {"type": "string"}, "ast": {"type": "string"}, "calls": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "evidence": {"type": "object", "required": ["type", "url"], "properties": {"type": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "sha": {"type": "string"}, "observed_at": {"type": "string"}}, "additionalProperties": true}
  }
}

